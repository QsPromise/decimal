{
  "name": "@qingshanscript/decimal",
  "version": "0.1.0",
  "description": "A modern decimal arithmetic library powered by BigInt",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "decimal",
    "arbitrary-precision",
    "bigint",
    "toFixed",
    "bignum"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QsPromise/decimal.git"
  },
  "homepage": "https://github.com/QsPromise/decimal",
  "bugs": {
    "url": "https://github.com/QsPromise/decimal/issues"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
